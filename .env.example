# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://zyntra:zyntra@localhost:5432/zyntra?schema=public

# ── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Verification / reset codes
CODE_TTL_MINUTES=15

# ── Redis (optional — used for rate limiting when set) ─
REDIS_URL=

# ── Mail (SMTP). Leave HOST empty in dev to log emails ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zyntra <no-reply@zyntra.app>"

# ── Uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_AVATAR_MB=2
# Public base URL used to build absolute file URLs
PUBLIC_URL=http://localhost:4000

# ── Claude AI (optional — template fallback when empty) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MAX_TOKENS=1200

# ── Groq AI (optional — compatible fallback) ──────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── ML prediction microservice (FastAPI, optional) ─────
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT_MS=4000

# ── Browser extension ──────────────────────────────────
# Comma-separated chrome-extension:// origins allowed to call the API
EXTENSION_ORIGINS=
EXTENSION_TOKEN_TTL=2h
