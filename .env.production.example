# ─────────────────────────────────────────────────────────────
# Zyntra — production environment template
# Copy to .env and fill every value. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Exact frontend origin(s). No trailing slash. No wildcards in production.
CORS_ORIGINS=https://zyntra.app
# Absolute base URL of this API, used to build file and download URLs.
PUBLIC_URL=https://api.zyntra.app

# ── Database ─────────────────────────────────────────────────
# Use a dedicated least-privilege role and require TLS.
DATABASE_URL=postgresql://zyntra_app:CHANGE_ME@db.internal:5432/zyntra?schema=public&sslmode=require

# ── Auth ─────────────────────────────────────────────────────
# Two DIFFERENT 32-byte hex secrets. Rotating these invalidates all sessions.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
CODE_TTL_MINUTES=15

# ── Redis ────────────────────────────────────────────────────
# Strongly recommended in production: enables shared rate-limit counters and
# cross-instance caching. Without it each instance limits and caches alone.
REDIS_URL=redis://:CHANGE_ME@redis.internal:6379

# ── Mail ─────────────────────────────────────────────────────
# SMTP is available only on Railway Pro and above. On lower plans, leave these
# blank and use RESEND_API_KEY so email is delivered over HTTPS.
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
MAIL_FROM="Zyntra <no-reply@zyntra.app>"
RESEND_API_KEY=
BREVO_API_KEY=

# ── Uploads ──────────────────────────────────────────────────
# Mount a persistent volume at this path; container storage is ephemeral.
UPLOAD_DIR=/app/uploads
MAX_AVATAR_MB=2

# ── Claude AI (optional) ─────────────────────────────────────
# Leave blank to serve deterministic template responses instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MAX_TOKENS=1200

# ── ML prediction service (optional) ─────────────────────────
# Leave blank to use the equivalent built-in local model.
ML_SERVICE_URL=http://ml:8000
ML_SERVICE_TIMEOUT_MS=4000

# ── Browser extension ────────────────────────────────────────
# Pin the published extension id once it is on the Chrome Web Store.
EXTENSION_ORIGINS=chrome-extension://YOUR_PUBLISHED_EXTENSION_ID
EXTENSION_TOKEN_TTL=2h
